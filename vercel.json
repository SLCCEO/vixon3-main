{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/router?route=:route*" },
    { "source": "/staff-login", "destination": "/index.html" },
    { "source": "/neural-override", "destination": "/index.html" },
    { "source": "/node", "destination": "/index.html" },
    { "source": "/editor", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/live", "destination": "/index.html" },
    { "source": "/dossier", "destination": "/index.html" },
    { "source": "/stats", "destination": "/index.html" },
    { "source": "/archives", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/lore", "destination": "/index.html" },
    { "source": "/streamers", "destination": "/index.html" },
    { "source": "/partnerships", "destination": "/index.html" },
    { "source": "/staff", "destination": "/index.html" },
    { "source": "/careers", "destination": "/index.html" },
    { "source": "/patreon", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://static-cdn.jtvnw.net https://*.twitchcdn.net https://cdn.discordapp.com https://media.discordapp.net; connect-src 'self' https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com; frame-src https://player.twitch.tv https://www.twitch.tv; frame-ancestors 'none'; form-action 'self'; media-src 'self' blob:; upgrade-insecure-requests"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" }
      ]
    }
  ]
}
