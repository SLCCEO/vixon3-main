DISCORD_BOT_TOKEN=replace-with-discord-bot-token
CLIENT_ID=replace-with-discord-application-id
DISCORD_GUILD_ID=replace-with-server-id
# Optional command deploy override; defaults to DISCORD_GUILD_ID; leave both blank for global commands.
GUILD_ID=
BOT_API_KEY=replace-with-private-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-secret-key
PORT=8788
CORS_ORIGIN=https://www.vixon.online
STAFF_ROLE_ID=
# Optional alert channel ID. Without it, moderation alerts go to the bot console only.
MODERATION_ALERT_CHANNEL_ID=
# Accounts newer than this are flagged for human review (default: 7 days).
MIN_ACCOUNT_AGE_DAYS=7
# Alert once when this many members join within the configured window.
JOIN_SPIKE_THRESHOLD=5
JOIN_SPIKE_WINDOW_SECONDS=60

# JSON object of Discord user IDs to display on the staff page.
# LOA requests DM the VexonCore and Testing10325 entries.
DISCORD_STAFF_IDS={"VexonCore":"000000000000000000","Testing10325":"000000000000000000","Shadow":"000000000000000000","A Random User":"000000000000000000","gisellehrndz":"000000000000000000"}

# Twitch credentials are used by the website's Vercel /api/twitch routes, not this bot.
# Keep these configured only in Vercel unless you add Twitch commands to the bot.
